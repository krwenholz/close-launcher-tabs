{
  "manifest_version": 3,
  "name": "Close Launcher Tabs",
  "version": "1.1.0",
  "key": "",
  "description": "Closes the leftover tab that Slack, Linear, Notion, etc. open to launch their desktop app.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Close Launcher Tabs",
    "default_popup": "popup.html"
  }
}
